# ==============================================================================
# CRM SAAS - BACKEND (NestJS + Prisma) - VARIABLES DE ENTORNO (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP
# ------------------------------------------------------------------------------
# Puerto en el que escucha el backend. En Railway/Render, la plataforma asigna
# automáticamente la variable PORT. Para local se utiliza 3001.
PORT=3001

# URL pública del frontend desplegado en Vercel (o tu dominio personalizado).
# Se utiliza en la configuración de CORS para permitir peticiones seguras.
# Ejemplo: https://crm-importadoras.vercel.app
FRONTEND_URL=https://tu-crm.vercel.app

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS SUPABASE (PostgreSQL con Prisma)
# ------------------------------------------------------------------------------
# Connection string de Supabase.
# NOTA IMPORTANTE PARA SUPABASE EN PRODUCCIÓN:
# - Para queries normales (NestJS en ejecución): usa el Connection Pooler (puerto 6543 con ?pgbouncer=true)
# - Para migraciones Prisma (prisma migrate): usa la conexión directa (puerto 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# (Opcional) URL directa para ejecutar migraciones si usas PgBouncer en DATABASE_URL
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN SUPABASE (JWT)
# ------------------------------------------------------------------------------
# Secret JWT de Supabase para validar tokens de usuarios autenticados.
# Lo encuentras en: Supabase Dashboard -> Project Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET="tu-supabase-jwt-secret-aqui"

# ------------------------------------------------------------------------------
# 4. SEGURIDAD Y CIFRADO DE CREDENCIALES
# ------------------------------------------------------------------------------
# Clave simétrica de exactamente 32 caracteres (AES-256) utilizada para cifrar
# las API Keys de Zernio, OpenAI y Canales almacenadas en la base de datos.
# Puedes generar una con: openssl rand -hex 16
AI_ENCRYPTION_KEY="12345678901234567890123456789012"

# ------------------------------------------------------------------------------
# 5. INTELIGENCIA ARTIFICIAL (OpenRouter / OpenAI)
# ------------------------------------------------------------------------------
# API Key para el Agente IA de CRM (generación de mensajes, análisis, chatbot).
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# (Opcional) Si utilizas directamente OpenAI
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 6. INTEGRACIÓN DE MENSAJERÍA (Zernio WhatsApp)
# ------------------------------------------------------------------------------
# API Key oficial de Zernio (https://zernio.com)
ZERNIO_API_KEY="zr_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# URL base del servicio de Zernio (por defecto https://api.zernio.com/v1)
ZERNIO_API_URL="https://api.zernio.com/v1"
