  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ------------------------------------------------------
// 13. Marketing: Campañas y Segmentos (Fase 4)
// ------------------------------------------------------

enum CampaignType {
  MANUAL
  AUTOMATICA_RECUPERACION
  AUTOMATICA_PRODUCTO
  AUTOMATICA_VENDEDOR
  EVENTO
}

enum CampaignTrigger {
  CLIENTE_INACTIVO
  NUEVO_PRODUCTO
  IMPORTACION_RECIBIDA
  COTIZACION_SIN_RESPUESTA
}

enum Priority {
  ALTA
  MEDIA
  BAJA
}

enum CampaignChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum CampaignObjective {
  VENTAS
  RETENCION
  INFORMATIVO
}

enum CampaignStatus {
  BORRADOR
  PROGRAMADA
  ENVIANDO
  PAUSADA
  CANCELADA
  COMPLETADA
}

enum RecipientStatus {
  PENDIENTE
  ENVIADO
  FALLIDO
  RESPONDIDO
}

enum SegmentType {
  CLIENTES
  LEADS
  MIXTO
}

model CampaignTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  nombre    String
  categoria String?
  cuerpo    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  messages  CampaignMessage[]

  @@index([tenantId])
}

model Campaign {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String            @db.Uuid
  nombre               String
  descripcion          String?
  canal                CampaignChannel
  objetivo             CampaignObjective
  responsableId        String            @db.Uuid
  estado               CampaignStatus    @default(BORRADOR)
  plantillaId          String?           @db.Uuid
  mensajePersonalizado String?
  enviarConIA          Boolean           @default(false)
  aprobada             Boolean           @default(false)
  fechaCreacion        DateTime          @default(now())
  fechaProgramada      DateTime?
  fechaEnvioProgramado DateTime?
  configuracionCola    Json?

  limiteMensajesPorHora  Int?
  intervaloEntreEnviosMs Int     @default(1000)
  concurrencia           Int     @default(1)
  maxReintentos          Int     @default(3)
  pausada                Boolean @default(false)

  totalDestinatarios Int @default(0)
  totalEnviados      Int @default(0)
  totalEntregados    Int @default(0)
  totalFallidos      Int @default(0)
  totalRespuestas    Int @default(0)
  totalLeads         Int @default(0)
  totalLeadsGenerados Int @default(0)
  totalCotizaciones  Int @default(0)
  totalVentas        Int @default(0)

  totalActividadesGeneradas Int @default(0)
  totalClientesVinculados   Int @default(0)
  costoTotal                Decimal @default(0) @db.Decimal(10, 4)

  tipo               CampaignType     @default(MANUAL)
  eventoDisparador   CampaignTrigger?
  productoId         String?          @db.Uuid
  vendedorObjetivoId String?          @db.Uuid
  segmentoId         String?          @db.Uuid
  ultimaEjecucion    DateTime?
  activaAutomatica   Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsable User                @relation("CampaignResponsable", fields: [responsableId], references: [id], onDelete: Restrict)
  plantilla   CampaignTemplate?   @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  segmento    Segment?            @relation(fields: [segmentoId], references: [id], onDelete: SetNull)
  recipients  CampaignRecipient[]
  messages    CampaignMessage[]
  costs       CampaignCost[]
  executions  CampaignExecution[]
  events      CampaignEvent[]

  productoObjetivo Product? @relation("CampaignProductoObjetivo", fields: [productoId], references: [id])
  vendedorObjetivo User?    @relation("CampaignVendedorObjetivo", fields: [vendedorObjetivoId], references: [id])

  @@index([tenantId])
  @@index([estado])
}

model CampaignRecipient {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String          @db.Uuid
  campaignId String          @db.Uuid
  clienteId  String?         @db.Uuid
  leadId     String?         @db.Uuid
  estado     RecipientStatus @default(PENDIENTE)
  motivo     String?

  respondio            Boolean   @default(false)
  fechaRespuesta       DateTime?
  leadGeneradoId       String?   @db.Uuid
  cotizacionGeneradaId String?   @db.Uuid
  pedidoGeneradoId     String?   @db.Uuid

  clienteVinculadoId  String? @db.Uuid
  actividadGeneradaId String? @db.Uuid

  prioridad         Priority?
  productoInteresId String?   @db.Uuid

  createdAt DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cliente  Customer?         @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  lead     Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages CampaignMessage[]
  events   CampaignEvent[]

  clienteVinculado   Customer? @relation("ClienteVinculado", fields: [clienteVinculadoId], references: [id])
  actividadGenerada  Activity? @relation("ActividadGenerada", fields: [actividadGeneradaId], references: [id])
  leadGenerado       Lead?     @relation("LeadGenerado", fields: [leadGeneradoId], references: [id])
  cotizacionGenerada Quote?    @relation("CotizacionGenerada", fields: [cotizacionGeneradaId], references: [id])
  pedidoGenerado     Order?    @relation("PedidoGenerado", fields: [pedidoGeneradoId], references: [id])

  productoInteres Product? @relation("RecipientProductoInteres", fields: [productoInteresId], references: [id])

  @@unique([campaignId, clienteId])
  @@unique([campaignId, leadId])
  @@index([tenantId])
  @@index([campaignId])
}

model Segment {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @db.Uuid
  nombre       String
  descripcion  String?
  tipoSegmento SegmentType
  condiciones  Json

  esSegmentoDinamico Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([tenantId])
}

enum CampaignMessageStatus {
  PENDIENTE
  PROCESANDO
  ENVIADO
  ENTREGADO
  FALLIDO
}

model CampaignMessage {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                @db.Uuid
  campaignId   String                @db.Uuid
  recipientId  String                @db.Uuid
  plantillaId  String?               @db.Uuid
  contenido    String
  estado       CampaignMessageStatus @default(PENDIENTE)
  externalId   String?
  errorMensaje String?
  intentos     Int                   @default(0)
  fechaEnvio   DateTime?

  fechaEntregado DateTime?
  fechaFallido   DateTime?
  fechaRespuesta DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  plantilla CampaignTemplate? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([campaignId])
  @@index([estado])
}

// ------------------------------------------------------
// 14. Marketing: Configuración, Consentimiento, Exclusión y Costos (Fase 4.21 - 4.24)
// ------------------------------------------------------

enum ContactType {
  CUSTOMER
  LEAD
  EXTERNO
}

enum ConsentStatus {
  CONSENTIDO
  NO_CONSENTIDO
  PENDIENTE
}

model CampaignConfig {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String   @unique @db.Uuid
  campanasActivas         Boolean  @default(true)
  zeniorConfigurado       Boolean  @default(false)
  limiteMensajesPorDia    Int?     @default(1000)
  limiteMensajesPorHora   Int?     @default(100)
  intervaloEntreEnviosMs  Int      @default(1000)
  horarioPermitidoInicio  String?  @default("09:00")
  horarioPermitidoFin     String?  @default("19:00")
  costoPorMensajeWhatsapp Decimal? @default(0.05) @db.Decimal(10, 4)
  costoPorMensajeSms      Decimal? @default(0.02) @db.Decimal(10, 4)
  firma                   String?
  mensajePredeterminado    String?
  aprobacionObligatoria   Boolean  @default(true)
  permiteAutomatizaciones Boolean  @default(true)
  iaHabilitada            Boolean  @default(false)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Consent {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String        @db.Uuid
  contactoId           String
  tipoContacto         ContactType
  estado               ConsentStatus @default(PENDIENTE)
  canal                String?       @default("WHATSAPP")
  origen               String?
  ipOrigen             String?
  observaciones        String?
  fechaConsentimiento  DateTime?
  fuenteConsentimiento String?
  fechaCambio          DateTime      @default(now())
  customerId           String?       @db.Uuid
  leadId               String?       @db.Uuid

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@unique([tenantId, contactoId, tipoContacto])
}

model OptOut {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @db.Uuid
  contactoId     String
  tipoContacto   ContactType
  telefono       String?
  motivo         String?
  fechaExclusion DateTime    @default(now())
  creadoPorId    String?     @db.Uuid

  createdAt      DateTime    @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creadoPor User?  @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@unique([tenantId, contactoId, tipoContacto])
}

model CampaignCost {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  campaignId       String    @db.Uuid
  canal            String?   @default("WHATSAPP")
  costoUnitario    Decimal?  @default(0.05) @db.Decimal(10, 4)
  cantidadMensajes Int?      @default(0)
  costoTotal       Decimal?  @default(0.00) @db.Decimal(10, 4)
  fechaRegistro    DateTime? @default(now())
  moneda           String?   @default("USD")
  mensajesEnviados Int       @default(0)
  mensajesFallidos Int       @default(0)
  consumo          Decimal   @default(0) @db.Decimal(10, 4)
  costoEstimado    Decimal   @default(0) @db.Decimal(10, 4)
  proveedor        String?
  fecha            DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([campaignId])
}

enum CampaignExecutionStatus {
  INICIADA
  COMPLETADA
  FALLIDA
}

model CampaignExecution {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                  @db.Uuid
  campaignId         String                  @db.Uuid
  estado             CampaignExecutionStatus @default(INICIADA)
  fechaInicio        DateTime                @default(now())
  fechaFin           DateTime?
  totalDestinatarios Int                     @default(0)
  totalEnviados      Int                     @default(0)
  totalFallidos      Int                     @default(0)
  errorMensaje       String?
  createdAt          DateTime                @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([campaignId])
}

enum CampaignEventType {
  APERTURA
  CLIC
  RESPUESTA
  REBOTE
  OPT_OUT
}

model CampaignEvent {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @db.Uuid
  campaignId  String            @db.Uuid
  recipientId String?           @db.Uuid
  tipoEvento  CampaignEventType
  detalles    Json?
  fechaEvento DateTime          @default(now())
  createdAt   DateTime          @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([campaignId])
  @@index([recipientId])
}




